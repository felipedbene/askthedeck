		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"autoprefixer": "^10.5.0",
		"postcss": "^8.5.15",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^3.4.19",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	}
}
