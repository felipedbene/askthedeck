{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true
	},
	"include": [
		"src",
		"vite.config.ts",
		"worker-configuration.d.ts"
	],
	// Compiled paraglide output; its generic Request typings clash with the
	// workerd runtime globals from worker-configuration.d.ts.
	"exclude": [
		"src/lib/paraglide"
	]
}
