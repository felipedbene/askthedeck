{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ask-the-deck-web",
	"main": "build/_worker.js",
	"compatibility_date": "2025-11-28",
	// SvelteKit 3's server runtime imports node:async_hooks (AsyncLocalStorage).
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{ "pattern": "ask.debene.dev", "custom_domain": true },
		{ "pattern": "pergunte.debene.dev", "custom_domain": true },
		{ "pattern": "preguntale.debene.dev", "custom_domain": true }
	],
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "build",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "READINGS_KV",
			"id": "ed027d2465464528a5a3463c9a6f6c9a"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tarot",
			"database_id": "6b81bce2-6df7-44a2-b54d-6420e225d74c"
		}
	],
	// Isolated resources for PR preview deploys (wrangler preview) — never production data.
	"previews": {
		"kv_namespaces": [
			{
				"binding": "READINGS_KV",
				"id": "0ea3cb3531d345218aff354716bc2188"
			}
		],
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "tarot-preview",
				"database_id": "ec067ecf-154b-40c3-834b-f6f3c81ea801"
			}
		]
	}
}
